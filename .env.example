# 拾贝 · 复制为 .env 后按需修改
# 初始管理员密码（必填；仅首次启动时用于创建登录账号）
SHIBEI_PASSWORD=change-me-please
# 管理员用户名（可选，默认 admin）
SHIBEI_USERNAME=admin
# 对外 HTTP 端口（可选，默认 8080）
SHIBEI_HTTP_PORT=8080
# 时区
TZ=Asia/Shanghai

# ---- 多前缀 / 多实例部署参数（可选）----
# 浏览器访问前缀，决定 nginx location 与前端资源 base、cookie path（默认 /shibei/）
SHIBEI_BASE_PATH=/shibei/
# 镜像 tag（默认 local；同机并存多前缀实例时用不同 tag 隔离，如 apps）
SHIBEI_TAG=local
# pip 下载源（默认官方 PyPI；国内主机建议腾讯云/清华镜像，如 https://mirrors.cloud.tencent.com/pypi/simple）
PIP_INDEX_URL=https://pypi.org/simple
